{
  "security": {
    "bannedFunctions": [
      {
        "pattern": "eval",
        "message": "Do not use eval() as it allows arbitrary code execution",
        "severity": "critical"
      },
      {
        "pattern": "new Function",
        "message": "Avoid using new Function() constructor for security reasons",
        "severity": "critical"
      },
      {
        "pattern": "document.write",
        "message": "document.write is unsafe and can lead to XSS",
        "severity": "high"
      }
    ],
    "requiredValidations": [
      {
        "type": "input",
        "rules": [
          {
            "pattern": "sanitizeInput\\(",
            "message": "All user inputs must be sanitized",
            "severity": "critical"
          }
        ]
      },
      {
        "type": "authentication",
        "rules": [
          {
            "pattern": "validateToken\\(",
            "message": "Token validation required for authenticated routes",
            "severity": "critical"
          }
        ]
      }
    ]
  },
  "architecture": {
    "layerRules": [
      {
        "layer": "controllers",
        "allowedDependencies": ["services"],
        "message": "Controllers should only depend on services"
      },
      {
        "layer": "services",
        "allowedDependencies": ["repositories", "dtos"],
        "message": "Services should only depend on repositories and DTOs"
      },
      {
        "layer": "repositories",
        "allowedDependencies": ["models"],
        "message": "Repositories should only depend on models"
      }
    ],
    "patternRules": [
      {
        "pattern": "repository",
        "required": true,
        "locations": ["backend/src/repositories"],
        "naming": "^.*Repository$",
        "message": "Repository pattern must be followed for data access"
      },
      {
        "pattern": "service",
        "required": true,
        "locations": ["backend/src/services"],
        "naming": "^.*Service$",
        "message": "Service layer must be used for business logic"
      }
    ],
    "dependencyRules": {
      "maxDependencies": 5,
      "cyclicDependencyCheck": true,
      "allowedCircularDependencies": []
    }
  },
  "components": {
    "frontend": {
      "size": {
        "max": 300,
        "message": "Component file should not exceed 300 lines"
      },
      "stateManagement": {
        "patterns": [
          {
            "name": "useState",
            "maxPerComponent": 5,
            "message": "Too many useState hooks, consider using reducer"
          }
        ]
      },
      "props": {
        "maxProps": 10,
        "message": "Too many props, consider composition"
      }
    },
    "backend": {
      "controllers": {
        "maxMethods": 8,
        "message": "Controller has too many methods, consider splitting"
      },
      "services": {
        "maxMethods": 12,
        "message": "Service has too many methods, consider splitting"
      }
    }
  },
  "naming": {
    "components": {
      "pattern": "^[A-Z][a-zA-Z]+$",
      "message": "Component names must be PascalCase"
    },
    "hooks": {
      "pattern": "^use[A-Z][a-zA-Z]+$",
      "message": "Hook names must start with 'use' and be PascalCase"
    },
    "files": {
      "frontend": {
        "pattern": "^[a-z-]+\\.(tsx?|jsx?)$",
        "message": "Frontend file names must be kebab-case"
      },
      "backend": {
        "pattern": "^[a-z-.]+\\.(ts|js)$",
        "message": "Backend file names must be kebab-case"
      }
    }
  },
  "testing": {
    "coverage": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "critical": {
        "paths": [
          "backend/src/security",
          "backend/src/auth"
        ],
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "patterns": {
      "describe": {
        "pattern": "^describe\\('.*'",
        "message": "Test suites must use describe blocks"
      },
      "it": {
        "pattern": "^it\\('should",
        "message": "Test cases should start with 'should'"
      }
    }
  },
  "documentation": {
    "components": {
      "required": [
        "Props interface",
        "Component description",
        "Example usage"
      ],
      "pattern": "^/\\*\\*[\\s\\S]*?\\*/"
    },
    "functions": {
      "required": [
        "Parameters",
        "Return value",
        "Throws"
      ],
      "pattern": "^/\\*\\*[\\s\\S]*?\\*/"
    },
    "mbk": {
      "required": [
        "Purpose",
        "Key Methods",
        "Dependencies"
      ],
      "pattern": "^# MBK:"
    }
  }
}
