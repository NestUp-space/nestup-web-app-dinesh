generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                      @id @default(autoincrement())
  name                String
  email               String                   @unique
  password            String
  profilePicUrl       String?
  phoneNumber         String                   @unique
  verified            Boolean                  @default(false)
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  roleId              Int
  teamId              Int?
  clientMarketplace   ClientMarketplace?
  comments            Comment[]
  designerMappings    DesignerProjectMapping[] @relation("Designer")
  newEngineerProjects EngineerProjectMapping[] @relation("NewEngineerProjects")
  oldEngineerProjects EngineerProjectMapping[] @relation("OldEngineerProjects")
  assignedTeams       EngineerTeamMapping[]
  filesUploaded       File[]                   @relation("FilesUploaded")
  generatedDocuments  GeneratedDocument[]
  createdProjects     Project[]                @relation("UserCreatedProjects")
  designerProjects    Project[]                @relation("DesignerProjects")
  engineerProjects    Project[]                @relation("EngineerProjects")
  managedProjects     Project[]                @relation("ProjectManagerProjects")
  updatedProjects     Project[]                @relation("UserUpdatedProjects")
  tasksUpdated        Task[]                   @relation("TaskUpdatedBy")
  managedTeam         Team?                    @relation("TeamManager")
  role                UserRole                 @relation(fields: [roleId], references: [id])
  team                Team?                    @relation("TeamMembers", fields: [teamId], references: [id])
  actions             UserAction[]
  lidarSessions       LidarSession[]
}

model Team {
  id        Int                   @id @default(autoincrement())
  name      String
  managerId Int                   @unique
  engineers EngineerTeamMapping[]
  manager   User                  @relation("TeamManager", fields: [managerId], references: [id])
  members   User[]                @relation("TeamMembers")
}

model Project {
  id                       Int                      @id @default(autoincrement())
  name                     String
  description              String?
  address                  String?                  @default("N/A")
  location                 String?                  @default("N/A")
  sqft                     Int?                     @default(0)
  statusId                 Int                      @default(1)
  designerId               Int?
  engineerId               Int?
  createdById              Int
  updatedById              Int
  estimatedTime            DateTime?                @default(now())
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  vbCount                  Int                      @default(0)
  generatedPlankListFileId Int?
  projectManagerId         Int?
  comments                 Comment[]
  designerMappings         DesignerProjectMapping[] @relation("DesignerProjectMappings")
  engineerMappings         EngineerProjectMapping[]
  generatedDocuments       GeneratedDocument[]
  materials                Material[]
  createdBy                User                     @relation("UserCreatedProjects", fields: [createdById], references: [id])
  designer                 User?                    @relation("DesignerProjects", fields: [designerId], references: [id])
  engineer                 User?                    @relation("EngineerProjects", fields: [engineerId], references: [id])
  generatedPlankListFile   File?                    @relation("GeneratedPlankListFile", fields: [generatedPlankListFileId], references: [id])
  projectManager           User?                    @relation("ProjectManagerProjects", fields: [projectManagerId], references: [id])
  status                   Status                   @relation(fields: [statusId], references: [id])
  updatedBy                User                     @relation("UserUpdatedProjects", fields: [updatedById], references: [id])
  projectInstances         ProjectModelInstance[]
  tasks                    Task[]
  userActions              UserAction[]
}

model Task {
  id             Int            @id @default(autoincrement())
  projectId      Int
  name           String
  stage          String?
  statusId       Int            @default(1)
  uploaderRole   String?
  viewerRoles    String?
  actionRequired String?
  metadataJson   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  updatedById    Int?
  sequenceIndex  Int? // Added for maintaining task order
  startedAt      DateTime?
  completedAt    DateTime?
  comments       Comment[]
  files          File[]
  siteVisitBoxes SiteVisitBox[]
  subtasks       Subtask[]
  project        Project        @relation(fields: [projectId], references: [id])
  status         Status         @relation(fields: [statusId], references: [id])
  updatedBy      User?          @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  userActions    UserAction[]
}

model Subtask {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  actionRequired   String?
  type             String?
  metadataJson     String?
  completed        Boolean  @default(false)
  isTemplateSubtask Boolean  @default(false)
  taskId           Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model File {
  id                  Int       @id @default(autoincrement())
  taskId              Int
  fileUrl             String
  uploadedBy          Int
  uploadedAt          DateTime  @default(now())
  task                Task      @relation(fields: [taskId], references: [id])
  uploadedByUser      User      @relation("FilesUploaded", fields: [uploadedBy], references: [id])
  projectsAsPlankList Project[] @relation("GeneratedPlankListFile")
}

model DesignerProjectMapping {
  id         Int     @id @default(autoincrement())
  designerId Int
  projectId  Int
  designer   User    @relation("Designer", fields: [designerId], references: [id])
  project    Project @relation("DesignerProjectMappings", fields: [projectId], references: [id])

  @@unique([designerId, projectId])
}

model UserAction {
  id            Int      @id @default(autoincrement())
  updatedBy     Int
  projectId     Int
  taskId        Int
  updatedAt     DateTime @default(now())
  comment       String
  project       Project  @relation(fields: [projectId], references: [id])
  task          Task     @relation(fields: [taskId], references: [id])
  updatedByUser User     @relation(fields: [updatedBy], references: [id])
}

model UserRole {
  id           Int                     @id @default(autoincrement())
  role         String                  @unique
  roleType     String
  roleMappings RolePermissionMapping[]
  users        User[]
}

model UserPermission {
  id           Int                     @id @default(autoincrement())
  permission   String                  @unique
  roleMappings RolePermissionMapping[]
}

model RolePermissionMapping {
  id           Int            @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   UserPermission @relation(fields: [permissionId], references: [id])
  role         UserRole       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model Status {
  id       Int       @id @default(autoincrement())
  status   String
  projects Project[]
  tasks    Task[]
}

model EngineerProjectMapping {
  id            Int      @id @default(autoincrement())
  oldEngineerId Int
  newEngineerId Int
  projectId     Int
  handoverAt    DateTime @default(now())
  newEngineer   User     @relation("NewEngineerProjects", fields: [newEngineerId], references: [id])
  oldEngineer   User     @relation("OldEngineerProjects", fields: [oldEngineerId], references: [id])
  project       Project  @relation(fields: [projectId], references: [id])
}

model EngineerTeamMapping {
  id         Int  @id @default(autoincrement())
  engineerId Int
  teamId     Int
  engineer   User @relation(fields: [engineerId], references: [id])
  team       Team @relation(fields: [teamId], references: [id])
}

model Comment {
  id            Int      @id @default(autoincrement())
  commentText   String
  isInternal    Boolean
  createdAt     DateTime @default(now())
  createdBy     Int
  projectId     Int?
  taskId        Int?
  createdByUser User     @relation(fields: [createdBy], references: [id])
  project       Project? @relation(fields: [projectId], references: [id])
  task          Task?    @relation(fields: [taskId], references: [id])
}

model ClientMarketplace {
  id           Int     @id @default(autoincrement())
  clientId     Int     @unique
  isVisible    Boolean @default(false)
  portfolioUrl String
  projectsNum  Int
  location     String
  client       User    @relation(fields: [clientId], references: [id])
}

model Material {
  id                Int            @id @default(autoincrement())
  projectId         Int
  materialId        String
  plyThickness      Float
  innerLaminateCode String
  outerLaminateCode String
  overallThickness  Float
  plyType           PlyType
  grainDirection    GrainDirection
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  project           Project        @relation(fields: [projectId], references: [id])

  @@unique([projectId, materialId])
}

model SiteVisitBox {
  id        Int      @id @default(autoincrement())
  taskId    Int
  order     Int
  modelType String
  inputs    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id])
}

model ModelDefinition {
  id                       String                 @id @default(cuid())
  name                     String                 @unique
  description              String?
  imageUrl                 String?
  sampleRuntimeInputsJson  Json? // Field to potentially store modelScopedVariables if appropriate
  expectedOutputSchemaJson Json?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  bomItems                 ModelBomItem[]
  inputParameters          ModelInputParameter[]
  projectInstances         ProjectModelInstance[]
  // availableAddons relation would need to be defined here if used in seed
}

model ModelInputParameter {
  id                String          @id @default(cuid())
  modelDefinitionId String
  inputName         String
  displayLabel      String?
  inputType         String
  defaultValue      String?
  options           Json?
  unit              String?
  description       String?
  modelDefinition   ModelDefinition @relation(fields: [modelDefinitionId], references: [id], onDelete: Cascade)

  @@unique([modelDefinitionId, inputName])
}

model ModelBomItem {
  id                String          @id @default(cuid())
  modelDefinitionId String
  itemName          String
  itemType          BomItemType
  itemDescription   String?
  details           Json? // This field will store plankProperties
  itemLogicScript   String?
  addonModelId      String?
  modelDefinition   ModelDefinition @relation(fields: [modelDefinitionId], references: [id], onDelete: Cascade)

  @@unique([modelDefinitionId, itemName])
}

model ProjectModelInstance {
  id                  String               @id @default(cuid())
  projectId           Int
  modelDefinitionId   String
  runtimeInputsJson   Json
  uiDisplayOrder      Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  generatedDocuments  GeneratedDocument[]
  generatedPlankLists GeneratedPlankList[]
  modelDefinition     ModelDefinition      @relation(fields: [modelDefinitionId], references: [id])
  project             Project              @relation(fields: [projectId], references: [id])
}

model GeneratedPlankList {
  id                     String               @id @default(cuid())
  projectModelInstanceId String
  generatedAt            DateTime             @default(now())
  filePath               String?
  csvContent             String?
  projectModelInstance   ProjectModelInstance @relation(fields: [projectModelInstanceId], references: [id])
}

model GeneratedDocument {
  id                     String                @id @default(cuid())
  documentType           DocumentType
  fileName               String
  filePath               String
  generatedAt            DateTime              @default(now())
  userId                 Int?
  projectId              Int?
  projectModelInstanceId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  project                Project?              @relation(fields: [projectId], references: [id])
  projectModelInstance   ProjectModelInstance? @relation(fields: [projectModelInstanceId], references: [id])
  user                   User?                 @relation(fields: [userId], references: [id])
}

enum GrainDirection {
  Y
  N
}

enum PlyType {
  HDHMR
  Blockboard
  MDF
  Plywood
}

enum BomItemType {
  PLANK
  HARDWARE
  ADDON
}

model Booking {
  id                  String        @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  phone               String
  address             Json          // {street, city, state, pincode}
  preferredDateTime   DateTime
  alternateDateTime   DateTime?
  projectType         String?
  requirements        String?
  source              String        @default("website")
  utmParams           Json?         // {utm_source, utm_medium, utm_campaign}
  crmLeadId           String?
  calendarEventId     String?
  status              BookingStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([email])
  @@index([phone])
  @@index([preferredDateTime])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CRM_SYNCED
  CALENDAR_CREATED
  COMPLETED
  CANCELLED
  FAILED
}

enum DocumentType {
  INPUT_QA_CSV
  PRESSING_LIST_CSV
  OUTPUT_QA_CSV
  CUTLIST_PDF
  PLANKLABEL_PDF
  INSTALLATION_GUIDE_PDF
  PROFORMA_INVOICE_PDF
  FINAL_INVOICE_PDF
  PROJECT_PLANK_LIST_CSV
  LIDAR_FLOOR_PLAN_PDF
  LIDAR_BOM_CSV
  LIDAR_DIMENSION_REPORT_PDF
}

// ============================================
// LiDAR Session Management Models
// ============================================

model LidarSession {
  id            String              @id @default(cuid())
  userId        Int
  projectId     Int?                // Optional link to existing project
  name          String?             // User-friendly session name
  status        LidarSessionStatus  @default(CREATED)
  deviceId      String?             // LiDAR device identifier
  location      Json?               // {lat, lng} coordinates
  metadata      Json                @default("{}")  // Additional session metadata
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user          User                @relation(fields: [userId], references: [id])
  scanData      LidarScanData?
  processedData LidarProcessedData?
  walls         LidarWall[]
  features      LidarFeature[]
  placedModules LidarPlacedModule[]
  bom           LidarSessionBom?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model LidarScanData {
  id              String        @id @default(cuid())
  sessionId       String        @unique
  fileUrl         String?       // S3 URL for raw scan data
  fileSize        BigInt?       // File size in bytes
  pointCount      Int?          // Total number of scan points
  scanFormat      ScanFormat    @default(CSV_2D)
  uploadStatus    UploadStatus  @default(PENDING)
  chunksReceived  Int           @default(0)
  totalChunks     Int?
  checksum        String?       // MD5 checksum for verification
  rawData         Json?         // Raw point cloud data (for small datasets)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  session         LidarSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model LidarProcessedData {
  id                  String        @id @default(cuid())
  sessionId           String        @unique
  floorPlanJson       Json?         // Processed floor plan geometry
  roomDimensions      Json?         // {width, depth, height, area}
  wallCount           Int?
  processingStatus    ProcessingStatus @default(PENDING)
  processingTimeMs    Int?          // Processing duration
  errorMessage        String?
  processedFileUrl    String?       // S3 URL for processed data
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  session             LidarSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model LidarWall {
  id              String          @id @default(cuid())
  sessionId       String
  wallIndex       Int             // Order of wall in room
  startPoint      Json            // {x, y} start coordinates in mm
  endPoint        Json            // {x, y} end coordinates in mm
  length          Float           // Wall length in mm
  height          Float?          // Wall height in mm (default from room)
  normalVector    Json?           // {x, y} normal direction
  boundaryPoints  Json?           // Array of boundary points
  createdAt       DateTime        @default(now())

  session         LidarSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  features        LidarFeature[]
  placedModules   LidarPlacedModule[]

  @@unique([sessionId, wallIndex])
  @@index([sessionId])
}

model LidarFeature {
  id            String          @id @default(cuid())
  wallId        String?
  sessionId     String
  featureType   FeatureType     // WINDOW, DOOR, PROTRUSION, etc.
  position      Json            // {x, y, z} position in mm
  dimensions    Json            // {width, height, depth}
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now())

  wall          LidarWall?      @relation(fields: [wallId], references: [id], onDelete: Cascade)
  session       LidarSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([wallId])
}

// Module templates for LiDAR placement (extends existing ModelDefinition concept)
model LidarModuleTemplate {
  id                  String                @id @default(cuid())
  name                String                @unique
  category            ModuleCategory
  description         String?
  thumbnailUrl        String?
  modelUrl            String?               // GLB/GLTF 3D model URL
  defaultDimensions   Json                  // {width, height, depth} in mm
  constraints         Json                  // {minWidth, maxWidth, minHeight, ...}
  parameters          Json                  @default("{}")  // Configurable parameters
  placementRules      Json                  @default("{}")  // {allowedSurfaces, minHeightFromFloor, ...}
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  placedModules       LidarPlacedModule[]
}

model LidarPlacedModule {
  id              String                @id @default(cuid())
  sessionId       String
  templateId      String
  wallId          String?
  position        Json                  // {x, y, z} position in mm
  dimensions      Json                  // {width, height, depth} in mm
  rotation        Float                 @default(0)  // Rotation in degrees
  parameters      Json                  @default("{}")  // Custom parameters
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  session         LidarSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  template        LidarModuleTemplate   @relation(fields: [templateId], references: [id])
  wall            LidarWall?            @relation(fields: [wallId], references: [id])

  @@index([sessionId])
  @@index([templateId])
}

model LidarSessionBom {
  id              String        @id @default(cuid())
  sessionId       String        @unique
  materials       Json          // Array of material items
  cutList         Json          // Array of cut specifications
  hardware        Json          // Array of hardware items
  summary         Json          // {totalModules, totalArea, totalSheets, ...}
  generatedAt     DateTime      @default(now())

  session         LidarSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ============================================
// LiDAR-related Enums
// ============================================

enum LidarSessionStatus {
  CREATED
  UPLOADING
  PROCESSING
  PROCESSED
  DESIGNING
  COMPLETED
  FAILED
}

enum ScanFormat {
  CSV_2D      // 2D polar scan (angle, range, x, y)
  PLY_3D      // 3D point cloud PLY format
  PCD_3D      // Point Cloud Data format
  NPY_3D      // NumPy array format
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
}

enum ProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum FeatureType {
  WINDOW
  DOOR
  PROTRUSION
  RECESS
  COLUMN
  SWITCHBOARD
  OTHER
}

enum ModuleCategory {
  STORAGE
  KITCHEN
  WARDROBE
  BATHROOM
  LIVING
  OFFICE
  CUSTOM
}
