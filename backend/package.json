    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.8.2",
    "puppeteer": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.10.0",
    "typescript": "^5.0.4",
    "uuid": "^11.1.0",
    "vm2": "^3.9.19",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
