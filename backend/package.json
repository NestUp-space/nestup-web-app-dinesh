{
  "$schema": "https://json.schemastore.org/package",
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "ts-node src/server.ts",
    "dev": "nodemon -r tsconfig-paths/register src/server.ts",
    "build": "tsc && tsc-alias && npm run build:seed",
    "build:seed": "tsc prisma/seed.ts --outDir dist --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports --resolveJsonModule --skipLibCheck --target es2018 --module commonjs",
    "prestart": "npm run migrate:prod && npx prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "setup:admin": "ts-node src/scripts/setupAdminRoleAndUser.ts",
    "create:admin": "ts-node src/scripts/createAdminUser.ts"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js",
    "generate": "prisma generate",
    "migrate:prod": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.966.0",
    "@aws-sdk/lib-storage": "^3.810.0",
    "@google-cloud/storage": "^7.16.0",
    "@prisma/client": "^6.8.2",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.1.0",
    "@types/node-fetch": "^2.6.12",
    "@types/puppeteer": "^5.4.7",
    "@types/swagger-ui-express": "^4.1.8",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "envalid": "^8.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "file-saver": "^2.0.5",
    "googleapis": "^154.1.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.3",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.0",
    "jszip": "^3.10.1",
    "mathjs": "^15.1.0",
