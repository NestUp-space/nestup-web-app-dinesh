# GCP Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./path-to-your-service-account-key.json
GCP_BUCKET_NAME=your-gcs-bucket-name

# Database (Cloud SQL)
# Option 1: Using Cloud SQL Proxy (recommended for local development)
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/DB_NAME?schema=public"
# Option 2: Direct connection (for Cloud Run with VPC connector or public IP - ensure security)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?schema=public&sslmode=require"
# Example for Cloud Run with Unix Sockets (most secure for Cloud Run)
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost/DB_NAME?schema=public&host=/cloudsql/PROJECT_ID:REGION:INSTANCE_ID"

# Application
PORT=8080
NODE_ENV=development # or production
FRONTEND_URL=http://localhost:3000 # For CORS

# Rate Limiting (optional, defaults are set in config)
# COMMON_RATE_LIMIT_MAX_REQUESTS=100
# COMMON_RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1h

# Admin User Setup (for initial setup script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strongpassword123
