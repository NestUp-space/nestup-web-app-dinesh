# This is an example environment file.
# For GCP deployments, please refer to .env.gcp.example and create a .env file from it.
# For other deployments, copy this file to .env and fill in your actual configuration values.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Application
PORT=8080
NODE_ENV=development # or production
FRONTEND_URL=http://localhost:3000 # For CORS

# Rate Limiting (optional, defaults are set in config)
# COMMON_RATE_LIMIT_MAX_REQUESTS=100
# COMMON_RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1h # Example: 1h, 7d

# Admin User Setup (for initial setup script if used)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strongpassword123

# If using a different storage provider than GCS, configure its variables here.
# Example for local file storage (if you were to implement it):
# STORAGE_TYPE=local
# LOCAL_STORAGE_PATH=./uploads
