# NestUp Visualiser Environment Configuration
# To run on localhost: copy this file to .env.local and replace placeholders with your values.
# Next.js loads .env.local automatically when you run npm run dev (port 3000).

# ---------------------------------------------------------------------------
# CATALOG (Google Sheets only - no CSV or static fallback)
# ---------------------------------------------------------------------------
# All cabinet and material data is loaded from Google Sheets. Configure API key
# and sheet IDs. The app tries /api/catalog (server proxy) first, then client
# fetch. Use GOOGLE_SHEETS_API_KEY on the server to hide the key from the client.

# Google Sheets API Key (required for catalog)
# Client (used when /api/catalog is not available):
NEXT_PUBLIC_GOOGLE_SHEETS_API_KEY=your_api_key_here
# Server (optional; used by GET /api/catalog to hide key from client):
# GOOGLE_SHEETS_API_KEY=your_api_key_here
#
# How to get your API key:
# 1. Go to https://console.cloud.google.com/
# 2. Enable "Google Sheets API" in APIs & Services > Library
# 3. Create Credentials > API Key
# 4. Make sure each sheet is shared "Anyone with the link can view"
#

# Sheet IDs (required for catalog) — use ONLY the ID from the URL, not the full URL.
# Example: from https://docs.google.com/spreadsheets/d/ABC123xyz/edit use ABC123xyz
# Central Cabinet Catalog (one sheet: Sheet1 with entity_name, level, box dimensions, etc.)
NEXT_PUBLIC_CATALOGUE_SHEET_ID=your_cabinet_sheet_id
# Material Catalog (only first two sheets are used: Laminate Catalog, Plywood Catalog)
# Sheet names can be "Laminate Catalog" / "Plywood Catalog" or "Laminate Library" / "Plywood Library"
NEXT_PUBLIC_MATERIAL_CATALOG_SHEET_ID=your_material_sheet_id
#
# Server-side override (optional; used by /api/catalog):
# CATALOGUE_SHEET_ID=...
# MATERIAL_CATALOG_SHEET_ID=...
#
# Wall measurement (vision-service) — required for /measurements flow
# Point the frontend to the Python vision-service so it can call /measure-wall.
# Run the vision-service: cd frontend/src/app/aruco-measurement-system/vision-service && pip install -r requirements.txt && python -m uvicorn main:app --host 0.0.0.0 --port 8000
NEXT_PUBLIC_MEASUREMENT_API_URL=http://localhost:8000

# Wall measurement app ("Continue to design" flow)
# Everything runs on one port: open http://localhost:3000/measurements (Next.js proxies to the Vite app in dev).
# MEASURE_APP_PORT = port where the ArUco Vite app runs (default 5173). Set to 5174 etc. if 5173 is in use.
# MEASURE_APP_PORT=5174
# NEXT_PUBLIC_ARUCO_APP_URL = URL of a separately deployed wall measurement app. Leave unset to use /measurements on same host.
# NEXT_PUBLIC_SHOW_WALL_MEASURE = set to "true" to show the "Measure your wall, then design" block on the Visualiser page.
# NEXT_PUBLIC_SHOW_WALL_MEASURE=true

