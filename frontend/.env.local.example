# NestUp Visualiser Environment Configuration
# Copy this file to .env.local and fill in your values

# Google Sheets API Key
# Required for live data sync from Google Sheets (5-minute auto-refresh)
# 
# How to get your API key:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select an existing one
# 3. Enable the "Google Sheets API" in APIs & Services > Library
# 4. Go to APIs & Services > Credentials
# 5. Click "Create Credentials" > "API Key"
# 6. Copy the API key and paste below
# 7. Make sure your Google Sheet is publicly viewable (anyone with link can view)
#
NEXT_PUBLIC_GOOGLE_SHEETS_API_KEY=your_api_key_here

# Sheet IDs (already configured in code - override only if needed)
# Central Catalogue: https://docs.google.com/spreadsheets/d/1A9W8gsjkalw8DHwmkRsh33UnOy5Y0seAUhyDrWNWeKA
# Material Catalog: https://docs.google.com/spreadsheets/d/1BJnNmIwG8J07LJGhnWQJ-gJbENSGJ2ArRCxypJAGMto
#
# Wall measurement app (for trials / "Continue to design" flow)
# Everything runs on one port: open http://localhost:3000/measurements (Next.js proxies to the Vite app in dev).
# MEASURE_APP_PORT = port where the ArUco Vite app runs (default 5173). Set to 5174 etc. if 5173 is in use.
# MEASURE_APP_PORT=5174
# NEXT_PUBLIC_ARUCO_APP_URL = URL of a separately deployed wall measurement app. Leave unset to use /measurements on same host.
# NEXT_PUBLIC_SHOW_WALL_MEASURE = set to "true" to show the "Measure your wall, then design" block on the Visualiser page.
# NEXT_PUBLIC_SHOW_WALL_MEASURE=true

# Uncomment and modify these only if you need to use different sheets:
# NEXT_PUBLIC_CATALOGUE_SHEET_ID=1A9W8gsjkalw8DHwmkRsh33UnOy5Y0seAUhyDrWNWeKA
# NEXT_PUBLIC_MATERIAL_CATALOG_SHEET_ID=1BJnNmIwG8J07LJGhnWQJ-gJbENSGJ2ArRCxypJAGMto
