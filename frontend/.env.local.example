# NestUp Visualiser Environment Configuration
# Copy this file to .env.local and fill in your values

# Google Sheets API Key
# Required for live data sync from Google Sheets (5-minute auto-refresh)
# 
# How to get your API key:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select an existing one
# 3. Enable the "Google Sheets API" in APIs & Services > Library
# 4. Go to APIs & Services > Credentials
# 5. Click "Create Credentials" > "API Key"
# 6. Copy the API key and paste below
# 7. Make sure your Google Sheet is publicly viewable (anyone with link can view)
#
NEXT_PUBLIC_GOOGLE_SHEETS_API_KEY=your_api_key_here

# Sheet IDs - set these to use your own Google Sheets as the catalog backend.
# The visualizer will load boxes from the Central Catalogue and materials from the Material Catalog.
# Both sheets must be shared as "Anyone with the link can view".
#
# Central Catalogue (boxes + planks): first tab should have headers like Entity Name, level, Material, Box_width, Box_depth, Box_height, carcass_thickness, etc.
NEXT_PUBLIC_CATALOGUE_SHEET_ID=11703K0CVVBxq8C1O1vlNKzLm-h-mIkjsOCau-wP2APo
#
# Material Catalog (Plywood Library + Laminate Library tabs). Default in code is Central Material Catalogue; uncomment to override.
# NEXT_PUBLIC_MATERIAL_CATALOG_SHEET_ID=1BJnNmIwG8J07LJGhnWQJ-gJbENSGJ2ArRCxypJAGMto
#
# Wall measurement app (for trials / "Continue to design" flow)
# MEASURE_APP_PORT=5174
# NEXT_PUBLIC_ARUCO_APP_URL = URL of a separately deployed wall measurement app.
# NEXT_PUBLIC_SHOW_WALL_MEASURE=true
