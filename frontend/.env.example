# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Authentication
NEXT_PUBLIC_AUTH_COOKIE_NAME=nestup_auth_token
NEXT_PUBLIC_AUTH_TOKEN_EXPIRY=86400 # 24 hours in seconds

# Feature Flags
NEXT_PUBLIC_ENABLE_REGISTRATION=true
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=true

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Deployment Environment
NEXT_PUBLIC_ENVIRONMENT=development # development, staging, production
