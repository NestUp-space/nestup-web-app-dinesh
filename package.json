{
  "name": "nestup-web-app",
  "version": "1.0.0",
  "description": "Nestup Web Application - Full Stack Project",
  "scripts": {
    "start": "node scripts/start-all.js",
    "start:backend-only": "cd backend && npm start",
    "build": "cd backend && npm install && npx prisma generate && npm run build && cd ../frontend && npm install && cross-env NEXT_PUBLIC_API_URL= npm run build",
    "railway:build": "cd backend && npm run railway:build",
    "railway:start": "cd backend && npm run railway:start",
    "dev": "cd backend && npm run dev",
    "migrate:prod": "cd backend && npm run migrate:prod"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "cross-env": "^7.0.3",
    "react-devtools": "^6.1.2"
  }
}
